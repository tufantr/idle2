# The staging copy of the Fantasy Idle API (deploy/vps/staging-setup.sh; installed as
# /etc/systemd/system/fantasyidle-api-staging.service). Its settings: /etc/fantasyidle/api-staging.env: its own
# database and token secret, port 3001, and no mail key, so it sends no mail.
[Unit]
Description=Fantasy Idle API, the private staging copy (staging.fantasyidle.com)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=fantasyidle
Group=fantasyidle
EnvironmentFile=/etc/fantasyidle/api-staging.env
WorkingDirectory=/srv/fantasyidle-staging/current
ExecStart=/usr/bin/node deploy/vps/server.cjs
Restart=always
RestartSec=2
# it reads its release and writes nothing to disk: everything else is shut away from it
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=300M

[Install]
WantedBy=multi-user.target
