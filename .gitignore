# Dependencies (api/node_modules is still tracked on purpose until a preview deploy
# confirms Vercel installs from api/package.json — see docs/ROADMAP.md, Phase 0)
node_modules/
!api/node_modules/

# Local databases and secrets
*.db
*.sqlite
.env
.env.*

# OS / editor noise
.DS_Store
.vercel

# Source paintings (only the converted assets/paint/*.webp are committed)
/art/

# Python bytecode from the tools/ scripts
__pycache__/

# Screenshots from tools/shots.mjs
/shots/

# Simulator batches from tools/batch.mjs
/runs/

# The wiki, built by wiki/build.mjs
/wiki/dist/
